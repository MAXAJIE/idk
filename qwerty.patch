diff --git a/backend/tests/test_binance_live.py b/backend/tests/test_binance_live.py
index 5662258..baf1b09 100644
--- a/backend/tests/test_binance_live.py
+++ b/backend/tests/test_binance_live.py
@@ -53,3 +53,33 @@ def test_open_bar_dropped_and_funding_point_in_time():
     funding = [((now - 3 * h) // 1000 - 10, 0.0001), ((now - 2 * h) // 1000 + 60, 0.0009)]  # 2nd settles after bar 2 opens
     bars = binance.attach_funding(kl, funding)
     assert [b.funding_rate for b in bars] == [0.0001, 0.0001]
+
+def test_rate_limit_418_ip_ban_extracted():
+    from app.live.testnet import RateLimitError
+    future_ban_ms = int(time.time() * 1000) + 60000
+    ban_msg = f'{{"code":-1003,"msg":"Way too many requests; IP(130.176.187.83) banned until {future_ban_ms}. Please use the websocket for live updates to avoid bans."}}'
+
+    def tr(method, url, headers):
+        return 418, ban_msg
+
+    client = TestnetClient(transport=tr)
+    with pytest.raises(RateLimitError) as exc:
+        client.klines("BTCUSDT", "1h")
+
+    assert exc.value.status == 418
+    assert exc.value.ban_until_ms == future_ban_ms
+    assert "-1003" in exc.value.body
+
+
+def test_rate_limit_429_raises_rate_limit_error():
+    from app.live.testnet import RateLimitError
+
+    def tr(method, url, headers):
+        return 429, '[Retry-After: 45] {"code":-1003,"msg":"Too many requests"}'
+
+    client = TestnetClient(key="K", secret="S", transport=tr)
+    with pytest.raises(RateLimitError) as exc:
+        client.equity()
+
+    assert exc.value.status == 429
+    assert exc.value.retry_after_s == 45.0
