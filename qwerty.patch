+def prepare_trade_config(cfg: ExperimentConfig, dry_run: bool) -> tuple[ExperimentConfig, bool]:
+    """Validate trade data source, allowing offline research configs in dry-run only.
+
+    Synthetic/CSV chromosomes can be previewed against Binance testnet public market
+    data, but this must never make a non-Binance research config eligible to place orders.
+    """
+    if cfg.data.source == "binance":
+        return cfg, False
+    if not dry_run:
+        raise ValueError("trade requires a Binance research experiment, not synthetic/CSV data")
+
+    # The default offline config uses a simulator-only symbol. Translate that known
+    # placeholder to the matching Binance market; keep explicitly configured symbols.
+    symbol = cfg.data.symbol
+    if symbol in {"BTC-PERP", "SIM"}:
+        symbol = "BTCUSDT"
+    data = cfg.data.model_copy(update={
+        "source": "binance",
+        "symbol": symbol,
+        "exchange": "BINANCE_USDM",
+    })
+    return cfg.model_copy(update={"data": data}), True
+
+
