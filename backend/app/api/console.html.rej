+function renderAgentDebate(payload) {
+  const box = $("agentDebate");
+  if (!payload || payload.status !== "complete") {
+    box.innerHTML = `<div class="empty">${esc(payload?.reason || "Agent debate unavailable")}</div>`;
+    return;
+  }
+  const turn = (role, title) => {
+    const t = payload.turns?.find(x => x.role === role);
+    if (!t) return `<div class="empty">${title}: no response.</div>`;
+    return `<section class="side ${role}" style="margin-top:10px"><h3>${title} · uncertainty ${fmt(t.uncertainty, 2)}</h3>
+      <ul>${(t.claims || []).map(c => `<li>${esc(c.text)} <span class="muted mono">${esc(c.evidence_id)} · weight ${fmt(c.weight, 2)}</span></li>`).join("") || "<li>No supported claims.</li>"}</ul>
+      <b>Counter-examination</b><ul>${(t.counterarguments || []).map(x => `<li>${esc(x)}</li>`).join("") || "<li>No counterargument supplied.</li>"}</ul>
+      <div class="muted">Invalidation: ${esc(t.invalidation)}</div></section>`;
+  };
+  box.innerHTML = `<div class="stats" style="margin-top:12px">${stat("Debate outcome", pill(payload.recommendation), "", true)}${stat("Evidence balance", fmt(payload.score, 3), cls(payload.score))}${stat("Provider", esc(payload.provider || "LLM"), "", true)}</div>
+    <p class="note">${esc(payload.scope || "Research display only. This debate does not affect trades.")}</p>${turn("bull", "Bull analyst")}${turn("bear", "Bear analyst")}`;
+}
+
+$("btnAgentDebate").onclick = async () => {
+  const button = $("btnAgentDebate");
+  button.disabled = true;
+  button.textContent = "Running two analyst turns…";
+  $("agentDebate").innerHTML = `<div class="empty">Using the last closed candle. This may take several seconds.</div>`;
+  try {
+    const result = await j(`/api/analysis/${$("sym").value}?tf=${$("tf").value}&limit=300&agents=llm`);
+    renderAgentDebate(result.agent_debate);
+  } catch (e) {
+    $("agentDebate").innerHTML = `<div class="empty">${esc(e.message)}</div>`;
+  } finally {
+    button.disabled = false;
+    button.textContent = "Run bull vs bear agents";
+  }
+};
+
 function drawIndicators() {
   if (!an || tab !== "debate") return;
   const s = an.series, c = an.candles;
