+    """Run one bounded evolutionary search on fixed WFA windows.
+
+    Outer-loop seed retries on the same OOS windows constitute repeated
+    validation peeking. Evolution therefore happens only inside this call; a
+    failed run requires genuinely fresh, untouched validation history.
+    """
+    if progress:
+        progress("state", {"to": "AUTO_SEARCH_SINGLE_PASS",
+                           "reason": "One WFA search only; do not reuse these OOS windows for seed retries", "round": 1})
+    res = train_and_combat(
+        bars=bars, cfg=cfg, base_population=base_population,
+        pop_size=pop_size, generations=generations,
+        elite_pool_size=elite_pool_size, min_consistency=min_consistency,
+        seed=seed,
+        progress=(lambda etype, payload: progress(etype, payload | {"round": 1}) if progress else None),
+    )
+    res.round_number = 1
+    res.total_rounds = 1
+    if max_rounds > 1:
+        res.summary += " Auto mode stopped after one search to protect the same OOS windows from repeated tuning."
+    return res, 1
 
 
